# ==============================================================================
# LOA INVOICE ENGINE - PLANTILLA DE ENTORNO
# Facturas PDF: vTiger -> GHL Cuenta Empresa -> workflow -> cliente
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INTERRUPTOR GENERAL
# ------------------------------------------------------------------------------
# El motor NACE APAGADO. Nada se publica hasta ponerlo en true.
INVOICE_PDF_ENABLED=false

# ------------------------------------------------------------------------------
# 2. VTIGER - WEBSERVICE (lectura de compras: challenge + login + query)
# ------------------------------------------------------------------------------
# Se usa para DETECTAR las compras nuevas (SalesOrder por contacto).
# vTiger es de SOLO LECTURA: este motor jamas escribe en el CRM.
VTIGER_URL=https://ventascallcenter.com
VTIGER_USERNAME=
VTIGER_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 3. VTIGER - SESION WEB (descarga del PDF oficial de la factura)
# ------------------------------------------------------------------------------
# El PDF lo genera la UI de vTiger (accion ExportPDF) detras de un login WEB.
# El access key de la API NO sirve para esto: hacen falta usuario y contrasena
# web, con permiso de exportar PDF en su rol.
VTIGER_WEB_USERNAME=
VTIGER_WEB_PASSWORD=
# Vida de la sesion web cacheada (ms). Default: 1200000 (20 min).
VTIGER_WEB_SESSION_TTL_MS=1200000

# ------------------------------------------------------------------------------
# 4. GOHIGHLEVEL - CUENTA EMPRESA (destino del PDF y del puente)
# ------------------------------------------------------------------------------
# Private Integration Token con scopes: medias.read, medias.write,
# contacts.readonly, contacts.write, locations.readonly, customFields.readonly
GHL_API_KEY_CENTRAL=
GHL_LOCATION_ID_CENTRAL=

# ------------------------------------------------------------------------------
# 5. DETECCION DE COMPRAS NUEVAS
# ------------------------------------------------------------------------------
# Cada cuantos minutos corre el escaneo (modo `scan`).
INVOICE_SCAN_INTERVAL_MINUTES=15
# Cuantos contactos compradores revisar por ciclo.
INVOICE_SCAN_BATCH=25
# Ventana de antiguedad de la ultima compra, en dias (evita resucitar historicos).
INVOICE_SCAN_DIAS=7
# Sede a escanear (PALACIOS | BENAVIDES | ROOSEVELT | PIURA | TODAS).
INVOICE_SCAN_SEDE=PALACIOS
# Ruta del cursor persistido (idempotencia entre ejecuciones).
INVOICE_CURSOR_PATH=data/cursor.json

# ------------------------------------------------------------------------------
# 6. RED / LOGS
# ------------------------------------------------------------------------------
GHL_HTTP_TIMEOUT_MS=30000
GHL_MAX_REINTENTOS=3
INVOICE_LOG_DIR=data/logs
